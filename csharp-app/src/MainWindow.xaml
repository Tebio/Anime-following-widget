<Window x:Class="AnimeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnimeWidget"
        Title="追番周表" Width="330" Height="520" MinWidth="280" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseLeftButtonDown="Root_Drag">

    <Window.Resources>
        <SolidColorBrush x:Key="FgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubBrush" Color="#DDE1EA"/>
        <SolidColorBrush x:Key="DimBrush" Color="#A6ACBD"/>
        <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="NewBrush" Color="#F04848"/>
        <SolidColorBrush x:Key="EndBrush" Color="#E88BB0"/>

        <!-- 文字阴影：把字从杂乱壁纸里"抠"出来——商业桌面挂件通透感的核心 -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="6" ShadowDepth="0" Direction="270"
                          Color="#000000" Opacity="0.62" RenderingBias="Quality"/>

        <!-- 番剧条目行 -->
        <DataTemplate x:Key="EntryTemplate" DataType="local:EntryViewModel">
            <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    Click="Entry_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                Padding="10,7" Margin="0,1"
                                Opacity="{Binding RowOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FgBrush}"
                                               Effect="{StaticResource TextShadow}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="185"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="New!" FontSize="9.5" FontStyle="Italic" FontWeight="Bold"
                                               Foreground="{StaticResource NewBrush}" Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsNew, Converter={x:Static local:BoolVisConverter.Instance}}"/>
                                </StackPanel>

                                <!-- 右侧：时间+集数（完结条目隐藏，改显示完结胶囊） -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsEnd, Converter={x:Static local:BoolVisConverter.Instance}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding TimeText}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF" Effect="{StaticResource TextShadow}"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding LabelText}" FontSize="10"
                                               Effect="{StaticResource TextShadow}"
                                               Foreground="{StaticResource SubBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="7" Padding="7,2"
                                        Background="#26E88BB0" VerticalAlignment="Center"
                                        Visibility="{Binding IsEnd, Converter={x:Static local:BoolVisConverter.Instance}}">
                                    <TextBlock Text="完结" FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource EndBrush}"/>
                                </Border>
                                <!-- 收藏星标：嵌套 Button 吃点击，不触发整行跳转 -->
                                <Button x:Name="StarBtn" Grid.Column="2" Tag="{Binding Model.DetailId}"
                                        Click="Star_Click" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" VerticalAlignment="Center" Margin="5,0,-2,0"
                                        Padding="2" Opacity="{Binding StarOpacity}"
                                        ToolTip="收藏（提醒只针对收藏的番）">
                                    <Grid>
                                        <TextBlock Text="★" FontSize="12"
                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Visibility="{Binding IsFavorite, Converter={x:Static local:BoolVisConverter.Instance}}"/>
                                        <TextBlock Text="☆" FontSize="12" Foreground="#C9CDD8"
                                                   Visibility="{Binding IsFavorite, Converter={x:Static local:BoolVisConverter.Instance}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                <Setter TargetName="StarBtn" Property="Opacity" Value="1"/>
                                <Setter TargetName="TitleText" Property="Foreground"
                                        Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <!-- 完结条目：整行降透明度 -->
                            <DataTrigger Binding="{Binding IsEnd}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" BorderThickness="1"
            Margin="6">
        <!-- 玻璃边缘：顶部受光、底部隐没 -->
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#33FFFFFF" Offset="0"/>
                <GradientStop Color="#0CFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <!-- 无外发光晕：单层干净卡片（用户实测反馈"背景两层"= 这个 26px 阴影圈） -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <StackPanel Margin="13,11,13,2">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="AccentDot" Width="7" Height="7"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="本周放送列表" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                   Effect="{StaticResource TextShadow}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="12" Cursor="Hand" ToolTip="立即刷新"
                                Click="Refresh_Click" Background="Transparent" BorderThickness="0"
                                Padding="4,2" Margin="0,0,4,0"
                                Foreground="{Binding AccentBrush}"/>
                        <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="12" Foreground="{StaticResource SubBrush}"
                                Cursor="Hand" ToolTip="设置" Click="Settings_Click"
                                Background="Transparent" BorderThickness="0" Padding="4,2"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource DimBrush}"
                           Effect="{StaticResource TextShadow}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding SourceText}" FontSize="9.5" Foreground="{StaticResource DimBrush}"
                           Effect="{StaticResource TextShadow}" Margin="0,1.5,0,0" Opacity="0.8"/>
            </StackPanel>

            <!-- 错误横幅（点击重试） -->
            <Border Grid.Row="1" x:Name="ErrorBanner" CornerRadius="10" Margin="12,4,12,0"
                    Background="#26F04848" BorderBrush="#40F04848" BorderThickness="1"
                    Padding="10,7" Cursor="Hand" MouseLeftButtonUp="ErrorBanner_Click"
                    Visibility="Collapsed" ToolTip="点击重试">
                <StackPanel>
                    <TextBlock Text="⚠ 抓取失败" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource NewBrush}"/>
                    <TextBlock x:Name="ErrorDetail" FontSize="9.5" Foreground="#D0A0A0"
                               TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="60"/>
                </StackPanel>
            </Border>

            <!-- 周几 pills（窗口变窄时可横向滚动，滚轮=横滚）。
                 HorizontalScrollBarVisibility 必须 Hidden 而非 Auto：
                 Auto 时 tab 轻微溢出就在 tab 行下冒出一条滚动条空带（用户圈出的"空白断层"），
                 Hidden 不影响 PreviewMouseWheel 的 ScrollToHorizontalOffset 编程滚动 -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Margin="11,7,10,3" PreviewMouseWheel="TabScroll_Wheel">
                <StackPanel x:Name="TabPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- 列表 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="6,1,6,4">
                <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}"
                              ItemTemplate="{StaticResource EntryTemplate}"/>
            </ScrollViewer>

            <!-- 状态栏 + 缩放手柄 -->
            <Grid Grid.Row="4" Margin="13,0,8,7">
                <TextBlock x:Name="StatusText" FontSize="9.5" Foreground="{StaticResource DimBrush}"
                           Effect="{StaticResource TextShadow}" VerticalAlignment="Center"/>
                <Rectangle x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Visibility="Collapsed"
                           Cursor="SizeNWSE" MouseLeftButtonDown="Grip_Resize">
                    <Rectangle.Fill>
                        <DrawingBrush Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#3FFFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="3,0,1,4"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>
    </Border>
</Window>
