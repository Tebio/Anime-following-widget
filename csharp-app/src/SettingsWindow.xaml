<Window x:Class="AnimeWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnimeWidget"
        Title="设置" Width="400" Height="680"
        Background="#FF161A22" Foreground="#EDEDF2"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="SubBrush" Color="#B9BEC9"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8B91A0"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2BA8A0"/>

        <!-- iOS 风开关（CheckBox → 拨杆），优效同款交互 -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- 必显式设前景！主题样式 ControlText(近黑) 优先级高于 Window.Foreground 继承，
                 不显式设 = 黑字压深卡 = 用户看到的"开关标题糊成一团" -->
            <Setter Property="Foreground" Value="#EDEDF2"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10"
                                    Background="#3A3F4A" Padding="2" VerticalAlignment="Center">
                                <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                        Background="#C9CDD8" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2BA8A0"/>
                                <Setter TargetName="Knob" Property="Background" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆头滑杆 Thumb 模板（按滑杆局部引用，别全局——会污染滚动条） -->
        <Style x:Key="RoundThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="White"
                                 Stroke="#2BA8A0" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调色实心按钮 -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 描边小按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BEC9"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="#3A3F4A" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 自定义标题栏关闭按钮：hover 变红 -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BEC9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 无边框窗口：自绘深色标题栏（优效同款），去掉系统白条的违和感。
         不用 AllowsTransparency（保住 ClearType），代价是直角——商业软件多数也直角 -->
    <Border BorderBrush="#2E3947" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#FF12151B" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"/>
                        <TextBlock Text="设置" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#x2715;" Style="{StaticResource TitleCloseBtn}"
                            HorizontalAlignment="Right" Click="CloseBtn_Click"/>
                </Grid>
            </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14">

            <!-- 外观 -->
            <TextBlock Text="外观" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="窗口透明度" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpacityValue" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <!-- IsMoveToPointEnabled=True 是"只有两个档"的根治：
                         默认 False 时点轨道按 LargeChange(=1.0) 步进，
                         跨度只有 0.9 → 点哪都撞 min/max，正好两档 -->
                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" IsMoveToPointEnabled="True"
                            Margin="0,6,0,2" ValueChanged="Opacity_Changed">
                        <Slider.Resources>
                            <Style TargetType="Thumb" BasedOn="{StaticResource RoundThumb}"/>
                        </Slider.Resources>
                    </Slider>
                    <TextBlock Text="面板有多透；文字始终清晰，不随透明度变淡" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <TextBlock Text="背景深浅" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DarknessValue" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="DarknessSlider" Minimum="0" Maximum="1.0" IsMoveToPointEnabled="True"
                            Margin="0,6,0,2" ValueChanged="Darkness_Changed">
                        <Slider.Resources>
                            <Style TargetType="Thumb" BasedOn="{StaticResource RoundThumb}"/>
                        </Slider.Resources>
                    </Slider>
                    <TextBlock Text="面板颜色：浅蓝灰 ↔ 深黑" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="BlurCheck" Style="{StaticResource Switch}" Content="磨砂背景（自截屏模糊）"/>
                    <TextBlock Text="把身后壁纸模糊后当卡片底，全 Windows 版本可用" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,6"/>
                    <TextBlock Text="强调色" FontSize="12" Margin="0,8,0,6"/>
                    <StackPanel x:Name="AccentPanel" Orientation="Horizontal"/>
                    <TextBlock Text="高亮颜色：今天、收藏星、按钮" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 行为 -->
            <TextBlock Text="行为" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,12">
                <StackPanel>
                    <TextBlock Text="点击番名打开" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel x:Name="ClickPills" Orientation="Horizontal" Margin="0,0,0,2"/>
                    <TextBlock Text="点番名时跳转到哪个页面" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="自动刷新间隔" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel x:Name="RefreshPills" Orientation="Horizontal" Margin="0,0,0,2"/>
                    <TextBlock Text="多久自动拉取一次最新放送数据" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ThroughCheck" Style="{StaticResource Switch}" Content="鼠标穿透（点击穿过卡片）"/>
                    <TextBlock Text="开启后点击直达桌面；想恢复：右键托盘图标里关闭" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                    <CheckBox x:Name="LockCheck" Style="{StaticResource Switch}" Content="锁定位置（禁止拖拽）"/>
                    <TextBlock Text="锁住后卡片不能拖动、不能拉伸" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                    <CheckBox x:Name="NotifyCheck" Style="{StaticResource Switch}" Content="更新提醒（收藏的番到点通知）"/>
                    <TextBlock Text="收藏的番到播出时间，右下角弹气泡提醒" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                    <CheckBox x:Name="FavOnlyCheck" Style="{StaticResource Switch}" Content="只显示收藏的番"/>
                    <TextBlock Text="列表只保留点过★的那几部" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                    <CheckBox x:Name="AutoSinkCheck" Style="{StaticResource Switch}" Content="点击浮上来，点别处沉下去"/>
                    <TextBlock Text="和优效等桌面插件的层级互动：点卡片=最上层，点别处=沉到桌面" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                    <CheckBox x:Name="EdgeHideCheck" Style="{StaticResource Switch}" Content="贴边隐藏"/>
                    <TextBlock Text="拖到屏幕边缘后缩成一条细边，鼠标靠近自动滑出" FontSize="10"
                               Foreground="{StaticResource DimBrush}" Margin="43,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- 桌面嵌入：选项卡式（长文本自动换行，不再截断） -->
            <TextBlock Text="桌面嵌入" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <StackPanel Margin="0,6,0,12">
                <Border x:Name="EmbedCardNormal" Background="{StaticResource CardBrush}" CornerRadius="12"
                        Padding="12,10" Margin="0,0,0,6" Cursor="Hand"
                        MouseLeftButtonUp="EmbedCard_Click" Tag="0">
                    <StackPanel>
                        <TextBlock Text="普通窗口（默认）" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="兼容 iTop / 酷呆等桌面整理软件，Win+D 会一起隐藏" FontSize="10.5"
                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="EmbedCardWorkerW" Background="{StaticResource CardBrush}" CornerRadius="12"
                        Padding="12,10" Margin="0,0,0,6" Cursor="Hand"
                        MouseLeftButtonUp="EmbedCard_Click" Tag="1">
                    <StackPanel>
                        <TextBlock Text="壁纸层" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="挂在壁纸上层，Win+D 不消失；可能与桌面整理软件冲突" FontSize="10.5"
                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="EmbedCardBottomPin" Background="{StaticResource CardBrush}" CornerRadius="12"
                        Padding="12,10" Margin="0,0,0,6" Cursor="Hand"
                        MouseLeftButtonUp="EmbedCard_Click" Tag="2">
                    <StackPanel>
                        <TextBlock Text="置底窗口" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="普通窗口压到最底，不抢焦点；Win+D 会一起隐藏" FontSize="10.5"
                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 数据诊断 -->
            <TextBlock Text="数据" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,10">
                <StackPanel>
                    <TextBlock x:Name="ProxyText" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                    <TextBlock x:Name="SourceTextDiag" FontSize="11" Foreground="{StaticResource SubBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="LastErrorText" FontSize="10" Foreground="#D08080"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button Content="立即刷新" Style="{StaticResource GhostBtn}" Margin="0,8,0,0"
                            Padding="14,5" HorizontalAlignment="Left" Click="RefreshNow_Click"/>
                </StackPanel>
            </Border>

            <Button Content="完成" Style="{StaticResource AccentBtn}" Padding="0,8" Click="Done_Click"/>
        </StackPanel>
    </ScrollViewer>
        </Grid>
    </Border>
</Window>
