<Window x:Class="AnimeWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnimeWidget"
        Title="设置" Width="360" Height="560"
        Background="#F014161C" Foreground="#EDEDF2"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="SubBrush" Color="#8F93A3"/>
        <SolidColorBrush x:Key="DimBrush" Color="#5C6070"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0AFFFFFF"/>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EDEDF2"/>
            <Setter Property="Margin" Value="0,3,14,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDEDF2"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14">

            <!-- 外观 -->
            <TextBlock Text="外观" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="窗口透明度" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpacityValue" FontSize="11" Foreground="{StaticResource SubBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" TickFrequency="0.05"
                            Margin="0,4,0,8" ValueChanged="Opacity_Changed"/>
                    <Grid>
                        <TextBlock Text="背景深浅" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DarknessValue" FontSize="11" Foreground="{StaticResource SubBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="DarknessSlider" Minimum="0" Maximum="1.0" TickFrequency="0.05"
                            Margin="0,4,0,8" ValueChanged="Darkness_Changed"/>
                    <TextBlock Text="强调色" FontSize="12" Margin="0,2,0,4"/>
                    <StackPanel x:Name="AccentPanel"/>
                </StackPanel>
            </Border>

            <!-- 行为 -->
            <TextBlock Text="行为" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,12">
                <StackPanel>
                    <TextBlock Text="点击番名打开" FontSize="12" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ClickDetail" Content="详情页（直达）" GroupName="click"/>
                        <RadioButton x:Name="ClickSearch" Content="搜索页" GroupName="click"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,2">
                        <TextBlock Text="自动刷新间隔" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RefreshCombo" Width="90" HorizontalAlignment="Right"
                                  SelectionChanged="RefreshCombo_Changed"/>
                    </Grid>
                    <CheckBox x:Name="ThroughCheck" Content="鼠标穿透（点击穿过卡片）"/>
                    <CheckBox x:Name="LockCheck" Content="锁定位置（禁止拖拽）"/>
                </StackPanel>
            </Border>

            <!-- 桌面嵌入 -->
            <TextBlock Text="桌面嵌入" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,12">
                <StackPanel>
                    <RadioButton x:Name="EmbedNormal" Content="普通窗口（默认，兼容 iTop/酷呆等桌面整理软件）" GroupName="embed"/>
                    <RadioButton x:Name="EmbedWorkerW" Content="壁纸层（Win+D 不消失，可能与桌面整理软件冲突）" GroupName="embed"/>
                    <RadioButton x:Name="EmbedBottomPin" Content="置底窗口（普通窗口压最底，Win+D 会一起隐藏）" GroupName="embed"/>
                    <TextBlock Text="和桌面整理软件冲突/壁纸层点不动时，切回普通窗口即可，立即生效不用重启" FontSize="10"
                               Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 数据诊断 -->
            <TextBlock Text="数据" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,6,0,4">
                <StackPanel>
                    <TextBlock x:Name="ProxyText" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                    <TextBlock x:Name="SourceTextDiag" FontSize="11" Foreground="{StaticResource SubBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="LastErrorText" FontSize="10" Foreground="#D08080"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button Content="立即刷新" Margin="0,8,0,0" Padding="14,5" HorizontalAlignment="Left"
                            Click="RefreshNow_Click"/>
                </StackPanel>
            </Border>

            <Button Content="完成" Margin="0,10,0,4" Padding="0,7" Click="Done_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
