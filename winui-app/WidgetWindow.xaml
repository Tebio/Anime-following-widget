<Window x:Class="AnimeWidget.WinUI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="using:H.NotifyIcon"
        Title="追番周表">

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 系统托盘 -->
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="追番周表" x:FieldModifier="public"
                        IconSource="ms-appx:///Assets/app.png">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="显示 / 隐藏" Click="Tray_Toggle"/>
                    <MenuFlyoutItem Text="立即刷新" Click="Refresh_Click"/>
                    <MenuFlyoutItem Text="设置" Click="Settings_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出" Click="Tray_Exit"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- 头部 -->
        <Grid x:Name="DragArea" Margin="14,10,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="AccentDot" Width="7" Height="7" Fill="#2BB6A3"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="本周放送列表" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="设置" Click="Settings_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="13"/>
                </Button>
                <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="立即刷新" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                </Button>
                <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="隐藏到托盘" Click="Hide_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="14,2,14,0">
            <TextBlock x:Name="SubtitleText" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="SourceText" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,1,0,0"/>
        </StackPanel>

        <!-- 周几 pills -->
        <StackPanel Grid.Row="2" x:Name="TabPanel" Orientation="Horizontal" Spacing="3"
                    Margin="12,8,12,2" HorizontalAlignment="Center"/>

        <!-- 搜索 -->
        <TextBox Grid.Row="3" x:Name="SearchBox" PlaceholderText="搜索标题…" Margin="12,4,12,6"
                 FontSize="12" TextChanged="SearchBox_TextChanged"/>

        <!-- 列表 -->
        <ListView Grid.Row="4" x:Name="EntryList" SelectionMode="None" Margin="6,0,6,2"
                  ItemClick="Entry_Click" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center"/>
                            <Border Background="#33F04848" CornerRadius="5" Padding="4,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="{Binding IsNewVis}">
                                <TextBlock Text="New!" FontSize="9" FontStyle="Italic" FontWeight="Bold"
                                           Foreground="#F04848"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Meta}" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Grid.Column="2" Padding="3,0" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" ToolTipService.ToolTip="收藏"
                                Tag="{Binding DetailId}" Click="Star_Click">
                            <TextBlock Text="{Binding Star}" FontSize="13" Foreground="#2BB6A3"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底栏 -->
        <Grid Grid.Row="5" Margin="14,0,14,8">
            <TextBlock x:Name="StatusText" FontSize="9.5" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
