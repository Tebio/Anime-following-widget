<Window x:Class="AnimeWidget.WinUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置">

    <ScrollViewer>
        <StackPanel x:Name="Root" Margin="18,14,18,18" Spacing="14">

            <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>

            <!-- 外观 -->
            <StackPanel Spacing="8">
                <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="界面效果" FontSize="12"/>
                    <StackPanel x:Name="MaterialPanel" Orientation="Horizontal" Spacing="6"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="OpacityLabel" FontSize="12"/>
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" StepFrequency="1"
                            ValueChanged="Opacity_Changed"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DarknessLabel" FontSize="12"/>
                    <Slider x:Name="DarknessSlider" Minimum="0" Maximum="100" StepFrequency="1"
                            ValueChanged="Darkness_Changed"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="强调色" FontSize="12"/>
                    <StackPanel x:Name="AccentPanel" Orientation="Horizontal" Spacing="8"/>
                </StackPanel>
            </StackPanel>

            <!-- 行为 -->
            <StackPanel Spacing="8">
                <TextBlock Text="行为" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="点击番名打开" FontSize="12"/>
                    <StackPanel x:Name="ClickTargetPanel" Orientation="Horizontal" Spacing="6"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="自动刷新间隔" FontSize="12"/>
                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Spacing="6"/>
                </StackPanel>
                <ToggleSwitch x:Name="ClickThroughSwitch" Header="鼠标穿透（点击穿过卡片）" Toggled="Toggle_Changed"/>
                <ToggleSwitch x:Name="LockSwitch" Header="锁定位置" Toggled="Toggle_Changed"/>
                <ToggleSwitch x:Name="HoverRevealSwitch" Header="悬停显示（平时隐身，鼠标靠近浮现）" Toggled="Toggle_Changed"/>
                <ToggleSwitch x:Name="EdgeHideSwitch" Header="贴边隐藏（靠边自动缩成细条）" Toggled="Toggle_Changed"/>
                <ToggleSwitch x:Name="NotifySwitch" Header="收藏番开播提醒" Toggled="Toggle_Changed"/>
                <ToggleSwitch x:Name="FavOnlySwitch" Header="只显示收藏的番" Toggled="Toggle_Changed"/>
            </StackPanel>

            <TextBlock Text="WinUI 3 预览线：贴边磁吸/隐藏、嵌入模式、背景深浅 后续版本补齐"
                       FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
