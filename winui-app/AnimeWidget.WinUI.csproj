<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- v4.0 WinUI 3 线：非打包 + WASDK 自包含，Win10 19044 起步（DeskBox 同款栈） -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19044.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <RootNamespace>AnimeWidget.WinUI</RootNamespace>
    <AssemblyName>AnimeWidget</AssemblyName>
    <Version>4.0.0</Version>
    <Description>追番桌面卡片 v4 — WinUI 3 重写（亚克力材质 + ClearType 文字）</Description>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile> <!-- WinUI3 无法单文件 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 必须开：否则不生成 .pri，运行时 LoadComponent 找不到 XBF → XamlParseException -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- DeskBox 实证可用配置：WASDK 2.2 + 系统 Windows App Runtime 2.x（用户机器已装） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.74" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
    <Content Include="Assets\app.png" />
  </ItemGroup>

</Project>
